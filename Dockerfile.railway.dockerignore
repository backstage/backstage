# Exclude everything, then allowlist only what the Dockerfile needs
**

# Yarn (needed for `yarn workspaces focus --production`)
!.yarn/
!.yarn/releases/
!.yarn/releases/**
!.yarnrc.yml
!yarn.lock
!package.json

# Pre-built backend artifacts
!packages/
!packages/backend/
!packages/backend/dist/
!packages/backend/dist/skeleton.tar.gz
!packages/backend/dist/bundle.tar.gz

# Frontend app config (loaded at runtime by the backend)
!packages/app/
!packages/app/app-config.yaml

# App configs and catalog
!app-config.yaml
!app-config.railway.yaml
!catalog-blitzy-sandbox.yaml
