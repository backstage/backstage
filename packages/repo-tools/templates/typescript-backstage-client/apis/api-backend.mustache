        // @ts-ignore
        request: {{#lambda.pascalcase}}{{nickname}}{{/lambda.pascalcase}},
        options?: BackendRequestOptions
    ): Promise<TypedResponse<{{{returnType}}} {{^returnType}}void{{/returnType}}>> {
        const baseUrl = await this.discovery.getBaseUrl(pluginId);

        const token =
            options?.token ??
            (
                await this.auth.getPluginRequestToken({
                    onBehalfOf:
                        options?.credentials ??
                        (await this.auth.getOwnServiceCredentials()),
                    targetPluginId: pluginId,
                })
            ).token;
{{>apis/operationRequest}}

