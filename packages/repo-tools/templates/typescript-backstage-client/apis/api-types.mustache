 */
export interface RequestOptions {
  token?: string;
}

/**
 * Options you can pass into a request made by the backend client.
 *
 * @public
 */
export interface BackendRequestOptions {
  /**
   * The credentials to make the request on behalf of. Defaults to the
   * credentials of the calling service.
   */
  credentials?: unknown;
  /**
   * An explicit plugin request token. When set, no token is requested from the
   * auth service.
   */
  token?: string;
}
