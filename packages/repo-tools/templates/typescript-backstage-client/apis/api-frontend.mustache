/**
 * A client for use in the frontend. Requests are sent to
 * `plugin://<pluginId>/...` URLs, which the `FetchApi` of the Backstage app
 * resolves to the plugin's base URL and adds credentials to.
 *
 * @public
 */
export class {{#lambda.pascalcase}}{{appName}}{{/lambda.pascalcase}}FrontendClient {
    private readonly client: {{#lambda.pascalcase}}{{appName}}{{/lambda.pascalcase}}Client;

    constructor(options: {
        fetchApi: { fetch: typeof fetch };
    }) {
        this.client = new {{#lambda.pascalcase}}{{appName}}{{/lambda.pascalcase}}Client({
            discoveryApi: {
                getBaseUrl: async (pluginId: string) => `plugin://${pluginId}`,
            },
            fetchApi: options.fetchApi,
        });
    }

    {{#apis}}
    {{#operations}}

    {{#operation}}
