/**
 * A client for use in the frontend. Requests are sent to
 * `plugin://<pluginId>/...` URLs, which the `FetchApi` of the Backstage app
 * resolves to the plugin's base URL and adds credentials to.
 *
 * @public
 */
export class DefaultApiFrontendClient {
    private readonly client: DefaultApiIsomorphicClient;

    constructor(options: {
        fetchApi: { fetch: typeof fetch };
    }) {
        this.client = new DefaultApiIsomorphicClient({
            discoveryApi: {
                getBaseUrl: async (pluginId: string) => `plugin://${pluginId}`,
            },
            fetchApi: options.fetchApi,
        });
    }

    {{#apis}}
