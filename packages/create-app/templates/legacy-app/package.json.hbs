{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
{{#if pnpm}}
    "build:backend": "pnpm --filter backend build",
{{else}}
    "build:backend": "yarn workspace backend build",
{{/if}}
    "build:all": "backstage-cli repo build --all",
{{#if pnpm}}
    "build-image": "pnpm --filter backend build-image",
{{else}}
    "build-image": "yarn workspace backend build-image",
{{/if}}
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/{{defaultBranch}}",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        },
        "templates": [
          "@backstage/cli-module-new/templates/legacy-frontend-plugin",
          "@backstage/cli-module-new/templates/backend-plugin",
          "@backstage/cli-module-new/templates/backend-plugin-module",
          "@backstage/cli-module-new/templates/plugin-web-library",
          "@backstage/cli-module-new/templates/plugin-node-library",
          "@backstage/cli-module-new/templates/plugin-common-library",
          "@backstage/cli-module-new/templates/web-library",
          "@backstage/cli-module-new/templates/node-library",
          "@backstage/cli-module-new/templates/cli-module",
          "@backstage/cli-module-new/templates/catalog-provider-module",
          "@backstage/cli-module-new/templates/scaffolder-backend-module"
        ]
      }
    }
  },
{{#unless pnpm}}
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
{{/unless}}
  "devDependencies": {
    "@backstage/cli": "^{{version '@backstage/cli'}}",
    "@backstage/cli-defaults": "^{{version '@backstage/cli-defaults'}}",
    "@backstage/e2e-test-utils": "^{{version '@backstage/e2e-test-utils'}}",
    "@jest/environment-jsdom-abstract": "^30.5.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
{{#if pnpm}}
    "@types/node": "^22.13.14",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.15.2",
{{/if}}
    "jest": "^30.5.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
{{#unless pnpm}}
  "resolutions": {
    "@yarnpkg/core": "4.9.1",
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
{{/unless}}
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
{{#if pnpm}}
  "packageManager": "pnpm@{{pnpmVersion}}"
{{else}}
  "packageManager": "yarn@4.13.0"
{{/if}}
}
