{
  "name": "@backstage/ai-node",
  "version": "0.1.0",
  "description": "Managed AI service primitives for Backstage backend plugins",
  "backstage": {
    "role": "node-library"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage"
  ],
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "packages/ai-node"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./modules": "./src/modules.ts",
    "./package.json": "./package.json",
    "./testUtils": "./src/testUtils.ts"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.ts"
      ],
      "modules": [
        "src/modules.ts"
      ],
      "package.json": [
        "package.json"
      ],
      "testUtils": [
        "src/testUtils.ts"
      ]
    }
  },
  "files": [
    "dist",
    "config.d.ts",
    "migrations"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "test": "backstage-cli package test"
  },
  "jest": {
    "resolver": "<rootDir>/../jestResolver.js"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "workspace:^",
    "@backstage/backend-test-utils": "workspace:^",
    "@backstage/config": "workspace:^",
    "@backstage/errors": "workspace:^",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "knex": "^3.0.0"
  },
  "devDependencies": {
    "@backstage/ai-node-codemode": "workspace:^",
    "@backstage/backend-test-utils": "workspace:^",
    "@backstage/cli": "workspace:^",
    "better-sqlite3": "^12.0.0",
    "jest": "^30.5.0",
    "pg": "^8.11.3"
  },
  "configSchema": "config.d.ts"
}
