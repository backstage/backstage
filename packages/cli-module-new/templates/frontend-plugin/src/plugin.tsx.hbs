import {
  createFrontendPlugin,
  PageBlueprint,
  ApiBlueprint,
  coreApis,
} from '@backstage/frontend-plugin-api';

import { rootRouteRef } from './routes';
import { todoApiRef } from './api/TodoApi';

const todoApi = ApiBlueprint.make({
  name: 'todos',
  params: defineParams =>
    defineParams({
      api: todoApiRef,
      deps: { fetchApi: coreApis.fetch },
      factory: async ({ fetchApi }) => {
        const { TodoClient } = await import('./api/TodoClient');
        return new TodoClient(fetchApi);
      },
    }),
});

export const page = PageBlueprint.make({
  params: {
    path: '/{{pluginId}}',
    routeRef: rootRouteRef,
    loader: () =>
      import('./components/TodoPage').then(m => (
        <m.TodoPage />
      )),
  },
});

export const {{ pluginVar }} = createFrontendPlugin({
  pluginId: '{{pluginId}}',
  info: { packageJson: () => import('../package.json') },
  extensions: [todoApi, page],
  routes: {
    root: rootRouteRef,
  }
});
