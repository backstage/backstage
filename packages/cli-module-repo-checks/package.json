{
  "name": "@backstage/cli-module-repo-checks",
  "version": "0.0.0",
  "description": "CLI module for checking the dependencies and metadata of packages in a Backstage repository",
  "backstage": {
    "role": "cli-module"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "packages/cli-module-repo-checks"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": "bin/backstage-cli-module-repo-checks",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/catalog-model": "workspace:^",
    "@backstage/cli-common": "workspace:^",
    "@backstage/cli-node": "workspace:^",
    "@manypkg/get-packages": "^1.1.3",
    "chalk": "^4.0.0",
    "cleye": "^2.6.0",
    "codeowners-utils": "^1.0.2",
    "fs-extra": "^11.2.0",
    "js-yaml": "^5.0.0",
    "p-limit": "^3.0.2",
    "ts-morph": "^24.0.0",
    "yaml-diff-patch": "^2.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "workspace:^",
    "@backstage/types": "workspace:^",
    "@types/node": "^24.0.0"
  }
}
