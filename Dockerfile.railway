# ---- Build Stage ----
FROM node:24-trixie-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-dev python3 build-essential && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app
COPY . .

RUN yarn install --inline-builds
# Generate type declarations; tolerate the 26 known pre-existing errors
RUN NODE_OPTIONS='--max-old-space-size=8192' yarn tsc || true
RUN yarn build:backend

# ---- Production Stage ----
FROM node:24-trixie-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-dev python3 python3-pip python3-venv build-essential && \
    rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
RUN pip3 install mkdocs-techdocs-core==1.1.7 mkdocs-mermaid2-plugin

RUN mkdir -p /data && chown node:node /data

WORKDIR /app
RUN chown node:node /app
USER node

ENV NODE_ENV=production

COPY --chown=node:node --from=build /app/.yarn ./.yarn
COPY --chown=node:node --from=build /app/.yarnrc.yml ./
COPY --chown=node:node --from=build /app/yarn.lock ./
COPY --chown=node:node --from=build /app/package.json ./
COPY --chown=node:node --from=build /app/packages/backend/dist/skeleton.tar.gz ./
RUN tar xzf skeleton.tar.gz && rm skeleton.tar.gz

RUN YARN_ENABLE_GLOBAL_CACHE=false yarn workspaces focus --all --production

# Install better-sqlite3 native module (same pattern as production Dockerfile)
RUN mkdir -p /tmp/sqlite3 && cd /tmp/sqlite3 && npm init -y && npm install better-sqlite3@11.10.0 && \
    cp -r node_modules/better-sqlite3 /app/node_modules/ && \
    { cp -r node_modules/bindings /app/node_modules/ 2>/dev/null || true; } && \
    { cp -r node_modules/file-uri-to-path /app/node_modules/ 2>/dev/null || true; } && \
    { cp -r node_modules/prebuild-install /app/node_modules/ 2>/dev/null || true; } && \
    { cp -r node_modules/node-addon-api /app/node_modules/ 2>/dev/null || true; } && \
    rm -rf /tmp/sqlite3

COPY --chown=node:node --from=build /app/packages/backend/dist/bundle.tar.gz ./
COPY --chown=node:node --from=build /app/app-config.yaml ./
COPY --chown=node:node --from=build /app/app-config.railway.yaml ./
COPY --chown=node:node --from=build /app/catalog-blitzy-sandbox.yaml ./
COPY --chown=node:node --from=build /app/packages/app/app-config.yaml ./packages/app/app-config.yaml
RUN tar xzf bundle.tar.gz && rm bundle.tar.gz

WORKDIR /app/packages/backend

EXPOSE 7007

CMD ["node", ".", "--config", "../../app-config.yaml", "--config", "../../app-config.railway.yaml", "--config", "../app/app-config.yaml"]
