{
  "name": "@backstage/plugin-golden-paths-backend",
  "version": "0.1.0",
  "description": "The Backstage backend plugin that helps you combine Scaffolder Templates into sequence",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "golden-paths",
    "pluginPackages": [
      "@backstage/plugin-golden-paths",
      "@backstage/plugin-golden-paths-backend",
      "@backstage/plugin-golden-paths-common",
      "@backstage/plugin-golden-paths-react"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage"
  ],
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "migrations/*.js"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "build:assets": "node scripts/build-nunjucks.js",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/backend-defaults": "workspace:^",
    "@backstage/backend-plugin-api": "workspace:^",
    "@backstage/catalog-client": "workspace:^",
    "@backstage/catalog-model": "workspace:^",
    "@backstage/config": "workspace:^",
    "@backstage/core-plugin-api": "workspace:^",
    "@backstage/errors": "workspace:^",
    "@backstage/plugin-auth-node": "workspace:^",
    "@backstage/plugin-catalog-node": "workspace:^",
    "@backstage/plugin-golden-paths-common": "workspace:^",
    "@backstage/plugin-permission-common": "workspace:^",
    "@backstage/plugin-permission-node": "workspace:^",
    "@backstage/plugin-scaffolder-common": "workspace:^",
    "@backstage/types": "workspace:^",
    "axios": "^1.13.5",
    "express": "4.22.2",
    "express-promise-router": "4.1.1",
    "jsonschema": "^1.5.0",
    "knex": "^3.0.0",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "qs": "^6.15.2",
    "uuid": "^14.0.1",
    "zen-observable": "^0.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "workspace:^",
    "@backstage/cli": "workspace:^",
    "@types/express": "4.17.25",
    "@types/lodash": "^4.14.151",
    "@types/qs": "^6",
    "@types/supertest": "^7.2.0",
    "@types/zen-observable": "^0.8.7",
    "supertest": "^7.2.2"
  }
}
