{
  "name": "@backstage/plugin-ai-gateway-backend",
  "version": "0.0.0",
  "description": "A backend plugin that exposes the Backstage AI models service over HTTP",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "ai-gateway",
    "pluginPackages": [
      "@backstage/plugin-ai-gateway-backend",
      "@backstage/plugin-ai-gateway-react"
    ]
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "plugins/ai-gateway-backend"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "config.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "generate": "backstage-repo-tools package schema openapi generate --server --client-package plugins/ai-gateway-react",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/backend-openapi-utils": "workspace:^",
    "@backstage/backend-plugin-api": "workspace:^",
    "@backstage/errors": "workspace:^",
    "@backstage/plugin-permission-common": "workspace:^",
    "@backstage/types": "workspace:^",
    "@types/express": "^4.17.6",
    "express": "^4.22.0"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "workspace:^",
    "@backstage/backend-test-utils": "workspace:^",
    "@backstage/cli": "workspace:^",
    "@backstage/repo-tools": "workspace:^",
    "@types/supertest": "^2.0.8",
    "supertest": "^7.0.0"
  },
  "configSchema": "config.d.ts"
}
