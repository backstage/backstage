  "backstage": {
    "role": "backend-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage",
    "catalog",
    "ai",
    "assistant",
    "llm"
  ],
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "plugins/catalog-assistant-backend"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
